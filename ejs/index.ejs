<!DOCTYPE html>
<html lang="en">

<head>
  <% include ./head %>
</head>

<body class="container">

  <div class="jumbotron">
    <h1>Workshops</h1>
    <p>here is the list of workshop</p>
  </div>

  <a type="button" href="/workshop" class="btn btn-success btn-lg">Create new workshop</a>

  <ul class="list-unstyled"></ul>
  <% workshops.forEach(function(workshop) { %>
    <li class="media my-4">
      <div class="media-body">
        <h5 class="mt-0 mb-1">
          <%= workshop.name %>
        </h5>
        <%= workshop.description %>
          <div class="mt-2">
            <form action="/update-workshop" method="get" style="display: inline;">
              <input type="hidden" name="name" value="<%= workshop.name %>">
              <button type="submit" class="btn btn-primary btn-sm">Update</button>
            </form>
            <form action="/remove-workshop" method="post" style="display: inline;">
              <input type="hidden" name="name" value="<%= workshop.name %>">
              <button type="submit" class="btn btn-danger btn-sm"
                onclick="return confirm('Are you sure you want to delete this workshop?')">Delete</button>
            </form>
          </div>
      </div>
      </div>
    </li>
    <% }); %>
      </ul>

      <footer>
        <% include ./footer %>
      </footer>

</body>

</html>